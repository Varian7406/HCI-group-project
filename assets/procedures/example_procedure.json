    "steps": [
        {
            "id": "s01",
            "instruction": "Shut down the PC through its operating system. Wait until all fans and lights have stopped. Click the power button to confirm the shutdown.",
            "expected_action": "select",
            "component_id": "power_button",
            "explanation": "Do not use Sleep. A full shutdown is required before working inside the computer."
        },
        {
            "id": "s02",
            "instruction": "Switch the power supply unit (PSU) to 0 (OFF).",
            "expected_action": "toggle",
            "component_id": "psu_switch",
            "explanation": "The PSU switch disconnects the power supply's normal output from the system."
        },
        {
            "id": "s03",
            "instruction": "Disconnect the AC power cable from the back of the computer.",
            "expected_action": "remove",
            "component_id": "power_cable",
            "explanation": "The computer must be disconnected from mains power before internal components are handled."
        },
        {
            "id": "s04",
            "instruction": "Remove the tempered-glass side panel. Before handling RAM, use an anti-static wrist strap or touch unpainted, grounded metal on the case.",
            "expected_action": "remove",
            "component_id": "glass_panel",
            "explanation": "Electrostatic discharge can damage memory modules. Keep the power cable disconnected."
        },
        {
            "id": "s05",
            "instruction": "Remove the existing RAM modules from the motherboard.",
            "expected_action": "remove",
            "component_id": "ram",
            "explanation": "Release the memory slot's retaining clips, then lift the RAM modules straight out. Handle them by their edges."
        },
        {
            "id": "s06",
            "instruction": "Install the replacement RAM modules in the motherboard memory slots.",
            "expected_action": "install",
            "component_id": "ram",
            "explanation": "Align the notch in the RAM with the key in the slot. Press evenly until the retaining clips secure the module."
        },
        {
            "id": "s07",
            "instruction": "Reinstall the tempered-glass side panel.",
            "expected_action": "install",
            "component_id": "glass_panel",
            "explanation": "Make sure the panel is properly seated and secured."
        },
        {
            "id": "s08",
            "instruction": "Reconnect the AC power cable to the computer.",
            "expected_action": "install",
            "component_id": "power_cable",
            "explanation": "Reconnect power only after the internal work and case reassembly are complete."
        },
        {
            "id": "s09",
            "instruction": "Switch the PSU back to I (ON).",
            "expected_action": "toggle",
            "component_id": "psu_switch",
            "explanation": "The PSU can be switched on after the power cable and case panel have been reconnected."
        },
        {
            "id": "s10",
            "instruction": "Press the case power button to start the PC.",
            "expected_action": "select",
            "component_id": "power_button",
            "explanation": "Check that the computer starts normally and that the replacement memory is detected."
        }
    ],
    "hazard": {
        "trigger_after_step": "s03",
        "message": "ELECTRICAL SAFETY ALERT: The mains cable is disconnected, but residual energy may remain in the system. Press and hold the case power button for approximately 5 seconds. This does NOT make the inside of the PSU safe to open. Never open the PSU.",
        "correct_component_id": "power_button",
        "response_window_ms": 10000
    }
}